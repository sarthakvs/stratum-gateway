# Copy to .env and edit as needed.
#
# Every value below is the built-in default, so an unset variable behaves
# exactly as shown here. A fresh clone runs with no .env file at all.

# --- HTTP server ---
ADDR=:8080

# --- Redis: breaker state, credit buckets, probe leases ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- Postgres: API keys, usage rows, semantic cache ---
POSTGRES_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable

# --- Providers ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Timeouts ---
# Max wall-clock for a single proxied request.
REQUEST_TIMEOUT=60s
# How long SIGTERM waits for in-flight streams before forcing close.
DRAIN_TIMEOUT=30s

# --- Availability tradeoff ---
# When Redis is unreachable: true = admit traffic, false = refuse it.
# See NFR-6. The reasoning belongs in the README.
FAIL_OPEN=true
